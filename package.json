{
  "name": "tamako-market-map",
  "private": true,
  "version": "1.0.0",
  "description": "《玉子市场》与《玉子爱情故事》交互式剧情地图（兔山商店街 & 京都圣地巡礼）",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "tsc -b && cf build",
    "deploy": "cf deploy --prebuilt --mode production",
    "deploy:dry-run": "cf deploy --prebuilt --mode production --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "1.0.0-rc.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
